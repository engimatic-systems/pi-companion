{
  "name": "@engimatic-systems/pi-companion",
  "version": "0.0.0",
  "private": true,
  "description": "Independently accessible Pi conversations with persistent local destinations",
  "keywords": ["pi-package"],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engimatic-systems/pi-companion.git"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "test:runtime": "tsx --test test/*.test.ts",
    "test:package": "node --test test/package-consumption.test.mjs",
    "test": "npm run typecheck && npm run test:runtime && npm run test:package"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "22.18.3",
    "tsx": "4.20.5",
    "typebox": "1.3.7",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "neverthrow": "8.2.0",
    "ts-pattern": "5.9.0"
  }
}
